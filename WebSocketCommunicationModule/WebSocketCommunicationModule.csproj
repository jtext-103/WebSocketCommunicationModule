<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Jtext103.CFET2.WebSocketCommunicationModule</PackageId>
    <Version>1.0.1</Version>
    <Authors>Jtext103</Authors>
    <Description>WebSocket communication module for CFET2 remote event subscriptions.</Description>
    <PackageTags>CFET2;WebSocket;communication;events;IoT</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="CFET2Core" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Exception\" />
  </ItemGroup>

</Project>
